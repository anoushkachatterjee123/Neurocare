def predict_parkinsons(input_features, model, scaler, feature_names):
    """
    Predict Parkinson's disease probability for new input.
    
    Parameters:
    -----------
    input_features : dict or array-like
        If dict: {feature_name: value, ...}
        If array: values in the same order as training features
    model : trained classifier
    scaler : fitted StandardScaler
    feature_names : list of feature names
    
    Returns:
    --------
    dict with probability and prediction
    """
    # Convert input to DataFrame
    if isinstance(input_features, dict):
        input_df = pd.DataFrame([input_features])
    else:
        input_df = pd.DataFrame([input_features], columns=feature_names)
    
    # Ensure all features are present
    for col in feature_names:
        if col not in input_df.columns:
            input_df[col] = 0 # Default value for missing features
    
    input_df = input_df[feature_names] # Reorder columns
    
    # Scale the input
    input_scaled = scaler.transform(input_df)
    
    # Make prediction
    prediction = model.predict(input_scaled)[0]
    probability = model.predict_proba(input_scaled)[0]
    
    result = {
        'has_parkinsons': bool(prediction),
        'probability_healthy': float(probability[0]),
        'probability_parkinsons': float(probability[1]),
        'confidence': float(max(probability))
    }
    
    return result


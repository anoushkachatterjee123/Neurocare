# =============================================
# DATA LOADING AND PREPARATION
# =============================================

def load_images_from_folder(folder, label, img_size=IMG_SIZE):
    """Load images from a folder and assign labels."""
    images = []
    labels = []
    
    if not os.path.exists(folder):
        print(f"Warning: {folder} does not exist!")
        return images, labels
    
    for filename in os.listdir(folder):
        if filename.endswith(('.png', '.jpg', '.jpeg', '.bmp')):
            img_path = os.path.join(folder, filename)
            try:
                img = cv2.imread(img_path)
                img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
                img = cv2.resize(img, (img_size, img_size))
                images.append(img)
                labels.append(label)
            except Exception as e:
                print(f"Error loading {filename}: {e}")
    
    return images, labels

print("Loading images...")
healthy_images, healthy_labels = load_images_from_folder(HEALTHY_DIR, 0)
parkinsons_images, parkinsons_labels = load_images_from_folder(PARKINSONS_DIR, 1)


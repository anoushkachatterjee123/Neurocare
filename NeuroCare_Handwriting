def predict_parkinsons_from_image(image_path, model, img_size=IMG_SIZE):
    """
    Predict Parkinson's disease from handwriting image.
    
    Parameters:
    -----------
    image_path : str
        Path to the handwriting image
    model : trained Keras model
    img_size : int
        Size to resize image
    
    Returns:
    --------
    dict with prediction results
    """
    try:
        # Load and preprocess image
        img = cv2.imread(image_path)
        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
        img = cv2.resize(img, (img_size, img_size))
        img = img.astype('float32') / 255.0
        img = np.expand_dims(img, axis=0)
        
        # Make prediction
        probability = model.predict(img, verbose=0)[0][0]
        prediction = int(probability > 0.5)
        
        result = {
            'has_parkinsons': bool(prediction),
            'probability_healthy': float(1 - probability),
            'probability_parkinsons': float(probability),
            'confidence': float(max(probability, 1 - probability))
        }
        
        return result
    
    except Exception as e:
        return {'error': str(e)}


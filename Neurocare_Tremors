import pandas as pd
import numpy as np
import pickle
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score, classification_report
from sklearn.metrics import roc_auc_score


# -----------------------------
# 1. LOAD DATA
# -----------------------------
data = pd.read_csv("tremor.csv")

tremor_features = [
    "Magnitude_mean",
    "Magnitude_std_dev",
    "Magnitude_var",
    "Magnitude_rms",
    "Magnitude_iqr",
    "Magnitude_med_dev",
    "Magnitude_avg_diff_mean"
]

X = data[tremor_features]

# -----------------------------
# 2. TRAIN/TEST SPLIT FIRST
# -----------------------------
X_train, X_test, y_raw_train, y_raw_test = train_test_split(
    X,
    data[["Rest_tremor", "Constancy_of_rest"]],
    test_size=0.2,
    random_state=42,
    stratify=data["Rest_tremor"]
)

# -----------------------------
# 3. DEFINE TARGET USING TRAINING DATA ONLY
# -----------------------------
threshold = y_raw_train["Constancy_of_rest"].quantile(0.75)

y_train = (
    (y_raw_train["Rest_tremor"] == 1) &
    (y_raw_train["Constancy_of_rest"] >= threshold)
).astype(int)

y_test = (
    (y_raw_test["Rest_tremor"] == 1) &
    (y_raw_test["Constancy_of_rest"] >= threshold)
).astype(int)

# -----------------------------
# 4. SCALE
# -----------------------------
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

# -----------------------------
# 5. TRAIN MODEL
# -----------------------------
model = LogisticRegression(max_iter=1000)
model.fit(X_train_scaled, y_train)

# -----------------------------
# 6. EVALUATE
# -----------------------------
y_pred = model.predict(X_test_scaled)
accuracy = accuracy_score(y_test, y_pred)

print("Accuracy:", accuracy)
print("\nClassification Report:")
print(classification_report(y_test, y_pred))

# -----------------------------
# 7. SAVE MODEL
# -----------------------------
with open("tremor_model.pkl", "wb") as f:
    pickle.dump({
        "model": model,
        "scaler": scaler,
        "threshold": threshold,
        "features": tremor_features
    }, f)

print("Model saved successfully")


# -----------------------------
# 8. SAFE PREDICTION FUNCTION
# -----------------------------
def predict_parkinsons_probability(tremor_data, model, scaler):
    tremor_data = np.array(tremor_data).reshape(1, -1)
    tremor_data = scaler.transform(tremor_data)
    probability = model.predict_proba(tremor_data)[0][1]
    return probability


# Example usage
example_patient = [3.5, 2.0, 1.5, 2.8, 1.0, 3.2, 2]
probability = predict_parkinsons_probability(
    example_patient, model, scaler
)

print(f"Probability of Parkinson's: {probability:.2f}")
roc_auc = roc_auc_score(y_test, model.predict_proba(X_test_scaled)[:,1])
print("ROC AUC:", roc_auc)
